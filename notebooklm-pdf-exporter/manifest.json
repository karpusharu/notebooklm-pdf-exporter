{
  "manifest_version": 3,
  "name": "NotebookLM PDF Exporter",
  "version": "1.0.0",
  "description": "Export NotebookLM notes to PDF with one click",
  "permissions": ["activeTab", "downloads", "scripting"],
  "host_permissions": ["https://notebooklm.google.com/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": [
        "src/lib/html2canvas.min.js",
        "src/lib/html2pdf.bundle.min.js",
        "src/content/exportCore.js",
        "src/content/buttonInjector.js",
        "src/content/content.js"
      ],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
